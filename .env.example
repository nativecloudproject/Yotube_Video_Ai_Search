SECRET_KEY=change-me
PORT=5000

# ── 6주차 · S3 ──────────────────────────────
# STORAGE_BACKEND=local          # local | s3
# S3_BUCKET=team-N-xxxx
# AWS_REGION=ap-northeast-2

# ── 7주차 · DynamoDB ────────────────────────
