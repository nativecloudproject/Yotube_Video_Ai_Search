# 복사해서 .env 로 저장하세요.  (.env 는 git에 올라가지 않습니다)
SECRET_KEY=change-me
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
# DATABASE=path/to/local.db  # 기본값은 프로젝트 루트의 data.db

# ── 6주차 · S3 ──────────────────────────────
# STORAGE_BACKEND=local          # local | s3
# S3_BUCKET=team-N-xxxx
# AWS_REGION=ap-northeast-2

# ── 7주차 · DynamoDB ────────────────────────
# DB_BACKEND=sqlite              # sqlite | dynamodb
# DDB_PREFIX=team-N-

# ── 9주차 · Lambda + SNS ────────────────────
# NOTIFY_BACKEND=local           # local | sns
# SNS_TOPIC_ARN=arn:aws:sns:ap-northeast-2:...
